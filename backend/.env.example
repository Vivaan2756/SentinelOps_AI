# SentinelOps AI - Environment Configuration Example
# Copy this file to .env and configure local values.
# DO NOT commit .env or real credentials to Git.

# Application Settings
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME="SentinelOps AI"

# Database Settings (Local PostgreSQL 18)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
# Replace with your local PostgreSQL credentials:
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@127.0.0.1:5432/sentinelops_dev

# Logging
LOG_LEVEL=INFO

# Agentic AI Incident Investigation (Gemini 2.5 Flash)
# Set your Google Gemini API key to enable live LLM synthesis (optional; deterministic fallback if unset)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Security Notice:
# Default test user accounts created by scripts/create_test_users.py are strictly
# for development testing. Never use default or weak passwords in staging or production.
POSTGRES_PASSWORD=your_secure_postgres_password